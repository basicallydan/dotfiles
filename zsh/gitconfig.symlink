[alias]
  co = checkout
  reabse = rebase
  st = status
[user]
	name = Dan Hough
	email = daniel.hough@gmail.com
[filter "lfs"]
	clean = git-lfs clean -- %f
	smudge = git-lfs smudge -- %f
	process = git-lfs filter-process
	required = true
[push]
	default = current
[pull]
	rebase = true
[init]
	defaultBranch = main
